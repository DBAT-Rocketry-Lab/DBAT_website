---
// Hero.astro - Hero section from index.html
---
<section id="home" class="snap">
  <div class="hero">
    <!-- LEFT: TEXT -->
    <div class="hero-text">
      <h1 class="title">
        From Sketchbook<br>
        to Sky
      </h1>

      <p class="subtitle">
            Every prototype, redesign, failure,
      and launch — archived as it happened.
      </p>
    </div>

    <!-- RIGHT: IMAGE -->
    <div class="hero-image">
      <img src="/rocket3.png" alt="Rocket illustration">
    </div>
  </div>
</section>